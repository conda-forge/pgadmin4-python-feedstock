conda-forge has no Flask-Security-Too 5.8.3 (5.8.x stops at 5.8.2; 5.9 is
excluded upstream). 5.8.3 fixes open redirect GHSA-ccgp-pv8r-95wm.
Drop this patch once flask-security-too 5.8.3 is on conda-forge.

--- a/requirements.txt
+++ b/requirements.txt
@@ -38,7 +38,7 @@
 # semantics, so anything earlier in the 5.8 series would refuse all logins.
 # 5.8.3 fixes an open redirect in the default configuration
 # (GHSA-ccgp-pv8r-95wm).
-Flask-Security-Too>=5.8.3,<5.9; python_version > '3.9'
+Flask-Security-Too>=5.8.2,<5.9; python_version > '3.9'
 Flask-SocketIO==5.7.*
 Flask-SQLAlchemy==3.1.*
 Flask-WTF==1.2.*; python_version <= '3.9'
